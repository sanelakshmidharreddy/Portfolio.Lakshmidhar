# Backend environment — copy to .env and fill in real values.
# NEVER commit the real .env file.

PORT=5000

# Where contact emails are delivered
CONTACT_EMAIL=sanelakshmidharreddy@gmail.com

# Frontend origins allowed by CORS (comma-separated). Update for production:
FRONTEND_URL=http://localhost:3001

# SMTP credentials (e.g. Gmail App Password, or any SMTP provider)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Optional custom From header; defaults to EMAIL_USER
EMAIL_FROM=

# Frontend environment — copy to .env and fill in.
# Only VITE_* variables are exposed to the frontend bundle.
# NEVER put backend secrets here.

# Base URL of the contact backend (no trailing slash)
# Local example:  VITE_API_URL=http://localhost:5000
# Production:     VITE_API_URL=https://YOUR-BACKEND.onrender.com
VITE_API_URL=
